# Docker Test Environment Configuration for ChemChat

# Node Environment
NODE_ENV=test

# Database Configuration
DATABASE_URL="postgresql://test:test@postgres:5432/chemchat_test"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Elasticsearch Configuration
ELASTICSEARCH_NODE="http://elasticsearch:9200"
ELASTICSEARCH_URL="http://elasticsearch:9200"
ELASTICSEARCH_INDEX_PREFIX="chemchat_test"

# JWT Configuration (test values)
JWT_ACCESS_SECRET="test-super-secret-access-token-key-2024"
JWT_REFRESH_SECRET="test-super-secret-refresh-token-key-2024"
JWT_WS_SECRET="test-super-secret-websocket-token-key-2024"
JWT_MFA_SECRET="test-super-secret-mfa-token-key-2024"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_WS_EXPIRES_IN="1h"

# Security Configuration
BCRYPT_SALT_ROUNDS=4
MAX_FAILED_LOGIN_ATTEMPTS=5
SUSPICIOUS_LOCATION_THRESHOLD=1000
UNUSUAL_DEVICE_THRESHOLD=30

# Rate Limiting Configuration (relaxed for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_MS=300000
MFA_RATE_LIMIT_MAX_ATTEMPTS=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=2000
WS_RATE_LIMIT_WINDOW_MS=60000
WS_RATE_LIMIT_MAX_CONNECTIONS=20

# Token Revocation Configuration
REDIS_TOKEN_REVOCATION_PREFIX="test_revoked_tokens:"
TOKEN_REVOCATION_TTL=604800

# MFA Configuration
APP_NAME="ChemChat Test"
MFA_ISSUER="ChemChat Test"

# Kafka Configuration (optional for tests)
KAFKA_BROKERS="kafka:9092"
KAFKA_CLIENT_ID="chemchat-test-producer"
KAFKA_CONSUMER_GROUP="chemchat-test-consumers"

# Outbox Configuration
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_RETRIES=3
OUTBOX_RETRY_DELAY_MS=1000
OUTBOX_PROCESSING_INTERVAL_MS=500
OUTBOX_ENABLE_DLQ=false

# Server Configuration
PORT=3000

# Logging
LOG_LEVEL="error"

# Health Check
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Docker Environment Flag
DOCKER_ENV=true
CI=true

# Test Configuration
JEST_TIMEOUT=60000
TEST_TIMEOUT=300000